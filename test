    {
      "parameters": {
        "jsCode": "const name = ($node['Product Form'].json['Product Name (Optional)'] || 'product').replace(/\\s+/g, '_');\nconst style = $node['Product Form'].json['Ad Style'].split(' ')[0].toLowerCase();\nconst ratio = $node['Product Form'].json['Aspect Ratio'].split(' ')[0].replace(':', 'x');\nconst date = new Date().toISOString().split('T')[0];\nconst ts = Date.now();\nconst filename = `Ad_${name}_${style}_${ratio}_${date}_${ts}.jpg`;\n\nreturn {\n  json: {\n    filename,\n    success: true,\n    message: '✅ Professional ad ready for download!',\n    metadata: {\n      product_name: $node['Product Form'].json['Product Name (Optional)'] || 'Product',\n      ad_style: $node['Product Form'].json['Ad Style'],\n      aspect_ratio: $node['Product Form'].json['Aspect Ratio'],\n      created_at: new Date().toISOString()\n    }\n  },\n  binary: {\n    data: $input.item.binary.data,\n    mimeType: 'image/jpeg',\n    fileName: filename\n  }\n};"
      },
      "id": "9bc1f48b-1794-4ded-9b03-2240dd28df4e",
      "name": "6. Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
