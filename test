        "jsCode": "const raw = $input.item.json.output.trim();\nlet cleaned = raw.startsWith('```') ? raw.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim() : raw;\n\nconst parsed = JSON.parse(cleaned);\nconst aspectField = $node['Product Form'].json['Aspect Ratio'];\n\nlet width, height;\nif (aspectField.includes('16:9')) { width = 1920; height = 1080; }\nelse if (aspectField.includes('9:16')) { width = 1080; height = 1920; }\nelse if (aspectField.includes('4:5')) { width = 1080; height = 1350; }\nelse { width = 1024; height = 1024; }\n\nreturn {\n  json: {\n    background_prompt: parsed.background_prompt,\n    negative_prompt: parsed.negative_prompt,\n    width: width,\n    height: height,\n    product_no_bg_url: $node['Get BG Result'].json.image.url\n  }\n};"
