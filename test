    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "from PIL import Image\nimport io\n\n# Get binary data from previous nodes\nproduct_binary = $node['Download Product'].binary['data']\nbackground_binary = $node['Download BG'].binary['data']\n\n# Load images\nproduct_img = Image.open(io.BytesIO(product_binary)).convert('RGBA')\nbackground_img = Image.open(io.BytesIO(background_binary)).convert('RGBA')\n\n# --- Simple background removal (assumes light/white background) ---\n# Any pixel close to white becomes transparent\ndatas = product_img.getdata()\nnew_data = []\nfor item in datas:\n    r, g, b, a = item\n    if r > 240 and g > 240 and b > 240:  # near-white background\n        new_data.append((255, 255, 255, 0))\n    else:\n        new_data.append((r, g, b, a))\nproduct_img.putdata(new_data)\n\n# Resize product to fit background while maintaining aspect ratio\nbg_width, bg_height = background_img.size\nproduct_ratio = product_img.width / product_img.height\nbg_ratio = bg_width / bg_height\n\n# Calculate new product size (80% of background)\nif product_ratio > bg_ratio:\n    new_width = int(bg_width * 0.8)\n    new_height = int(new_width / product_ratio)\nelse:\n    new_height = int(bg_height * 0.8)\n    new_width = int(new_height * product_ratio)\n\nproduct_resized = product_img.resize((new_width, new_height), Image.Resampling.LANCZOS)\n\n# Center the product on background\nx_offset = (bg_width - new_width) // 2\ny_offset = (bg_height - new_height) // 2\n\n# Composite images using alpha channel of product_resized\nbackground_img.paste(product_resized, (x_offset, y_offset), product_resized)\n\n# Convert to bytes\noutput_buffer = io.BytesIO()\nbackground_img.convert('RGB').save(output_buffer, format='JPEG', quality=95)\noutput_bytes = output_buffer.getvalue()\n\nreturn {\n    'json': {\n        'success': True,\n        'width': bg_width,\n        'height': bg_height,\n        'product_size': f'{new_width}x{new_height}',\n        'position': f'{x_offset},{y_offset}'\n    },\n    'binary': {\n        'data': output_bytes\n    }\n}"
      },
